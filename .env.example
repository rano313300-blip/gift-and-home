# برای توسعه لازم نیست؛ برای سرور واقعی این متغیرها را به‌عنوان environment variable تنظیم کنید.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=یک-رشته-تصادفی-طولانی
DJANGO_ALLOWED_HOSTS=example.ir,www.example.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ir,https://www.example.ir

# درگاه پرداخت: mock (آزمایشی) یا zarinpal
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=0

# دیتابیس PostgreSQL (اگر تنظیم نشود SQLite استفاده می‌شود)
# POSTGRES_DB=dorhami
# POSTGRES_USER=dorhami
# POSTGRES_PASSWORD=...
# POSTGRES_HOST=localhost
